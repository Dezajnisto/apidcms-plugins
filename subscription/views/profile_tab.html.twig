{% set sub = current_subscription() %}
{% if sub is not empty %}
<!-- Active subscription -->
<div class="widget">
    <div class="widget__left">
        <div class="widget__indicator widget__indicator--green"></div>
        <div class="widget__text">
            <strong>{{ sub.plan_name }}</strong>
            <small>Действует до {{ sub.expires_at|date("d.m.Y") }}</small>
        </div>
    </div>
    <div class="widget__actions">
        <span style="background:#34D399;color:#0D0D12;padding:4px 14px;border-radius:999px;font-size:0.8rem;font-weight:700;">Активна</span>
        <span style="color:var(--muted);font-size:0.8rem;">
            {% if sub.amount > 0 %}{{ sub.amount }} &#8381; / {% endif %}
            {{ format_duration(sub.duration_days) }}
        </span>
    </div>
</div>
{% else %}
<!-- No subscription -->
<div class="widget">
    <div class="widget__left">
        <div class="widget__indicator widget__indicator--gray"></div>
        <div class="widget__text">
            <strong>Нет активной подписки</strong>
            <small>Оформите подписку, чтобы получить доступ ко всем промтам</small>
        </div>
    </div>
    <div class="widget__actions">
        {% for plan in get_plans() %}
        <a href="/subscribe/{{ plan.slug }}" class="btn btn--primary">
            {{ plan.name }}
            {% if plan.price > 0 %} - {{ plan.price }} &#8381;{% else %} - Бесплатно{% endif %}
            / {{ format_duration(plan.duration_days) }}
        </a>
        {% endfor %}
    </div>
</div>
{% endif %}
