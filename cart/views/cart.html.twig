{% extends "base.html.twig" %}

{% block content %}
<div class="max-w-3xl mx-auto mt-8 px-4">
    <h1 class="text-2xl font-bold mb-8">{{ title }}</h1>

    {% if cart_items is empty %}
    <div class="text-center py-16 text-gray-500">
        <div class="text-6xl mb-4">🛒</div>
        <p class="text-xl">Корзина пуста</p>
        <p class="mt-2">
            <a href="/" class="text-blue-600 hover:underline">Вернуться к покупкам</a>
        </p>
    </div>
    {% else %}
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">Товар</th>
                    <th class="px-4 py-3 text-center text-sm font-medium text-gray-500">Цена</th>
                    <th class="px-4 py-3 text-center text-sm font-medium text-gray-500">Кол-во</th>
                    <th class="px-4 py-3 text-right text-sm font-medium text-gray-500">Сумма</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody>
                {% for key, item in cart_items %}
                <tr class="border-t">
                    <td class="px-4 py-3">{{ item.product_name }}</td>
                    <td class="px-4 py-3 text-center">{{ item.price|number_format(2) }} ₽</td>
                    <td class="px-4 py-3 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="updateCart('{{ item.product_table }}', {{ item.product_id }}, {{ item.quantity - 1 }})"
                                class="w-8 h-8 rounded bg-gray-200 hover:bg-gray-300 text-sm font-bold">−</button>
                            <span class="w-8 text-center">{{ item.quantity }}</span>
                            <button onclick="updateCart('{{ item.product_table }}', {{ item.product_id }}, {{ item.quantity + 1 }})"
                                class="w-8 h-8 rounded bg-gray-200 hover:bg-gray-300 text-sm font-bold">+</button>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-right font-medium">{{ (item.price * item.quantity)|number_format(2) }} ₽</td>
                    <td class="px-4 py-3 text-center">
                        <button onclick="removeFromCart('{{ item.product_table }}', {{ item.product_id }})"
                            class="text-red-500 hover:text-red-700 text-xl">✕</button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot class="bg-gray-50">
                <tr>
                    <td colspan="3" class="px-4 py-3 text-right font-bold">Итого:</td>
                    <td class="px-4 py-3 text-right font-bold text-lg">{{ total|number_format(2) }} ₽</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="mt-6 flex justify-between">
        <a href="/" class="text-blue-600 hover:underline">← Продолжить покупки</a>
        <button class="bg-green-600 text-white py-2 px-6 rounded-md hover:bg-green-700">
            Оформить заказ
        </button>
    </div>
    {% endif %}
</div>

<script>
async function updateCart(table, id, qty) {
    if (qty < 1) {
        return removeFromCart(table, id);
    }
    const form = new FormData();
    form.append('product_table', table);
    form.append('product_id', id);
    form.append('quantity', qty);
    const resp = await fetch('/cart/update', { method: 'POST', body: form });
    if (resp.ok) location.reload();
}

async function removeFromCart(table, id) {
    const form = new FormData();
    form.append('product_table', table);
    form.append('product_id', id);
    const resp = await fetch('/cart/remove', { method: 'POST', body: form });
    if (resp.ok) location.reload();
}
</script>
{% endblock %}
