{# npd: чеки покупателя — ссылки на чеки «Мой налог» #}
{% extends 'base.html.twig' %}

{% block title %}Мои чеки{% endblock %}

{% block content %}
{# Цвета берём из переменных темы с фолбэком на светлую схему: шаблон должен
   выглядеть родным и в тёмной, и в светлой теме. #}
<style>
    .npd-page { max-width: 860px; margin: 0 auto; padding: 32px 24px 60px; color: var(--fg, #111827); }
    .npd-page h1 { font-size: 2rem; line-height: 1.2; margin-bottom: 12px; }
    .npd-lead { color: var(--muted, #6b7280); margin-bottom: 28px; max-width: 62ch; }
    .npd-table-wrap { border: 1px solid var(--border, #e5e7eb); border-radius: var(--radius-sm, 10px); overflow-x: auto; }
    .npd-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
    .npd-table th {
        text-align: left; font-weight: 500; font-size: 0.8rem; letter-spacing: 0.02em;
        text-transform: uppercase; color: var(--muted, #6b7280);
        padding: 12px 16px; border-bottom: 1px solid var(--border, #e5e7eb);
    }
    .npd-table td { padding: 14px 16px; border-bottom: 1px solid var(--border, #e5e7eb); }
    .npd-table tr:last-child td { border-bottom: 0; }
    .npd-table .npd-num { text-align: right; white-space: nowrap; }
    .npd-table .npd-date { color: var(--muted, #6b7280); white-space: nowrap; }
    .npd-table .npd-link { color: var(--accent-purple, #7c3aed); text-decoration: none; border-bottom: 1px solid currentColor; }
    .npd-table .npd-link:hover { opacity: 0.8; }
    .npd-wait { color: var(--muted, #9ca3af); }
    .npd-empty { color: var(--muted, #6b7280); }
    .npd-back { display: inline-block; margin-top: 28px; color: var(--accent-purple, #7c3aed); text-decoration: none; }
    .npd-back:hover { text-decoration: underline; }
</style>

<div class="npd-page">
    <h1>Мои чеки</h1>
    <p class="npd-lead">Чеки за оплаты на этом сайте. Каждый чек сформирован в сервисе ФНС
        «Мой налог» — по ссылке открывается официальный документ.</p>

    {% if receipts is empty %}
        <p class="npd-empty">Чеков пока нет. Как только появится оплата, чек придёт сюда.</p>
    {% else %}
        <div class="npd-table-wrap">
            <table class="npd-table">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Что оплачено</th>
                        <th class="npd-num">Сумма</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for r in receipts %}
                    <tr>
                        <td class="npd-date">{{ r.created_at }}</td>
                        <td>{{ r.description ?: 'Оплата' }}</td>
                        <td class="npd-num">{{ r.amount }} ₽</td>
                        <td class="npd-num">
                            {% if r.receipt_url %}
                                <a class="npd-link" href="{{ r.receipt_url }}" target="_blank" rel="noopener">Открыть чек</a>
                            {% elseif r.status == 'pending' or r.status == 'dry_run' %}
                                <span class="npd-wait">формируется</span>
                            {% else %}
                                <span class="npd-wait">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <a class="npd-back" href="/profile">← В личный кабинет</a>
</div>
{% endblock %}
