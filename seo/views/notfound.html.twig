{% extends "base.html.twig" %}

{% block title %}Ошибки 404{% endblock %}
{% block page_title %}SEO — ошибки 404{% endblock %}

{% block content %}
{% include '@seo/_styles.twig' %}
{% import '@seo/_icons.twig' as icons %}
<div class="seo-admin">
<div class="seo-wrap">

    {% if flash %}
    <div class="seo-flash {{ flash.type == 'error' ? 'seo-flash--error' : 'seo-flash--ok' }}">{{ flash.message }}</div>
    {% endif %}

    <div class="seo-toolbar">
        <div class="seo-toolbar__group">
            <a href="{{ admin_url('seo') }}" class="seo-btn seo-btn--link">{{ icons.icon('arrow-left') }} к обзору</a>
            <a href="{{ admin_url('seo/redirects') }}" class="seo-link seo-small">редиректы</a>
        </div>
    </div>

    <div class="seo-card seo-card--flush">
        <div class="seo-card__head">
            <span>Адреса, которых нет (топ по обращениям)</span>
            <span style="text-transform:none;letter-spacing:0;">рекомендуемый адрес — предположение по похожести, проверяйте глазами</span>
        </div>
        {% if rows is empty %}
        <div class="seo-empty">
            {{ icons.icon('check-circle', 28) }}
            <p>Хорошая новость: 404 не приходили с момента установки плагина.</p>
        </div>
        {% else %}
        <table class="seo-table">
            <thead>
                <tr>
                    <th>Адрес</th>
                    <th class="seo-table__num" style="width:110px;">Обращений</th>
                    <th style="width:170px;">Последний раз</th>
                    <th style="width:260px;">Куда перенаправить</th>
                    <th style="width:44px;"></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                <tr>
                    <td class="seo-table__mono">{{ row.path }}</td>
                    <td class="seo-table__num">
                        <span class="seo-badge {{ row.hits > 1 ? 'seo-badge--warn' : 'seo-badge--none' }}">{{ row.hits }}</span>
                    </td>
                    <td class="seo-small seo-muted">{{ row.last_seen }}</td>
                    <td>
                        {% if row.suggest %}
                        <form method="post" action="{{ admin_url('seo/redirects/save') }}" class="seo-toolbar__group" style="gap:6px;">
                            <input type="hidden" name="from_path" value="{{ row.path }}">
                            <input type="text" name="to_path" value="{{ row.suggest }}" class="seo-mono seo-small" style="width:170px;">
                            <button type="submit" class="seo-btn seo-btn--primary seo-btn--sm">301</button>
                        </form>
                        {% else %}
                        <span class="seo-small seo-faint">похожих адресов нет</span>
                        {% endif %}
                    </td>
                    <td style="text-align:right;">
                        <form method="post" action="{{ admin_url('seo/notfound/delete/' ~ row.id) }}"
                              onsubmit="return confirm('Удалить запись из журнала?')">
                            <button type="submit" class="seo-btn seo-btn--icon seo-btn--danger" title="Удалить">
                                {{ icons.icon('trash') }}
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

    <div class="seo-card" style="margin-top:16px;">
        <p class="seo-small seo-muted">
            Журнал ведётся на страницах ошибки. Технические адреса (файлы стилей, картинки, /admin)
            в него не попадают, чтобы отчёт не утонул в мусоре. Записи не чистятся автоматически —
            удаляйте их кнопкой.
        </p>
    </div>
</div>
</div>
{% endblock %}
