{% extends "base.html.twig" %}

{% block content %}
<div class="max-w-2xl mx-auto mt-12 px-4">
    <h1 class="text-2xl font-bold mb-8">{{ title }}</h1>

    {% if success %}
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-md mb-6">
        {{ success }}
    </div>
    {% endif %}

    {% if error %}
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md mb-6">
        {{ error }}
    </div>
    {% endif %}

    <div class="bg-white shadow rounded-lg p-6 mb-6">
        <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
                <span class="text-sm text-gray-500">Email</span>
                <p class="font-medium">{{ user.email }}</p>
            </div>
            <div>
                <span class="text-sm text-gray-500">Статус</span>
                <p class="font-medium">
                    {% if user.status == 'active' %}
                        <span class="text-green-600">Активен</span>
                    {% else %}
                        <span class="text-red-600">{{ user.status }}</span>
                    {% endif %}
                </p>
            </div>
        </div>

        <form method="post" action="/profile" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Имя</label>
                <input type="text" name="name" value="{{ user.name }}"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Телефон</label>
                <input type="tel" name="phone" value="{{ user.phone }}"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <button type="submit" class="bg-blue-600 text-white py-2 px-6 rounded-md hover:bg-blue-700 transition">
                Сохранить
            </button>
        </form>
    </div>

    <div class="text-center space-y-3">
        <a href="/account/change-password" class="block text-blue-600 hover:underline">Сменить пароль</a>
        <a href="/logout" class="text-red-600 hover:underline">Выйти</a>
    </div>
</div>
{% endblock %}
