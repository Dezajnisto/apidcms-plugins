{% extends "base.html.twig" %}

{% block title %}SEO: {{ doc.url }}{% endblock %}
{% block page_title %}SEO страницы{% endblock %}

{% block content %}
{% include '@seo/_styles.twig' %}
{% import '@seo/_icons.twig' as icons %}
<div class="seo-admin">
<div class="seo-wrap">

    <div class="seo-head">
        <div>
            <a href="{{ admin_url('seo') }}" class="seo-btn seo-btn--link seo-small">
                {{ icons.icon('arrow-left') }} ко всем страницам
            </a>
            <h1 class="seo-head__title">{{ doc.title is not empty ? doc.title : '(без заголовка)' }}</h1>
            <a href="{{ doc.url }}" target="_blank" rel="noopener" class="seo-link seo-small">
                {{ doc.url }} {{ icons.icon('external-link') }}
            </a>
        </div>
        <div class="seo-head__meta">
            <span class="seo-tag">{{ doc.type == 'page' ? 'страница' : (doc.type == 'record' ? 'запись: ' ~ doc.table : 'раздел') }}</span>
            {% if doc.updated_at %}<span>обновлено {{ doc.updated_at }}</span>{% endif %}
        </div>
    </div>

    {% if flash %}
    <div class="seo-flash {{ flash.type == 'error' ? 'seo-flash--error' : 'seo-flash--ok' }}">{{ flash.message }}</div>
    {% endif %}

    <!-- Панель нейросети: видна сразу, ничего не прячет -->
    <div class="seo-ai">
        <div class="seo-ai__row">
            <div>
                <p class="seo-ai__title">{{ icons.icon('sparkles') }} Заполнить нейросетью</p>
                <p class="seo-ai__hint">
                    {% if ai_ready %}
                    Пишет по тексту страницы. Результат сначала показывается предложением —
                    примените или отмените, ничего не перезаписывается молча.
                    {% else %}
                    Недоступно: не задан ключ DeepSeek в <a href="{{ admin_url('settings') }}" class="seo-link">настройках AI</a>.
                    {% endif %}
                </p>
            </div>
            <div class="seo-ai__buttons">
                <button type="button" data-ai="all" class="seo-btn seo-btn--ai seo-btn--sm ai-run" {{ ai_ready ? '' : 'disabled' }}>Всё сразу</button>
                <button type="button" data-ai="title" class="seo-btn seo-btn--ghost seo-btn--sm ai-run" {{ ai_ready ? '' : 'disabled' }}>Заголовок</button>
                <button type="button" data-ai="description" class="seo-btn seo-btn--ghost seo-btn--sm ai-run" {{ ai_ready ? '' : 'disabled' }}>Описание</button>
                <button type="button" data-ai="keyword" class="seo-btn seo-btn--ghost seo-btn--sm ai-run" {{ ai_ready ? '' : 'disabled' }}>Ключевые фразы</button>
            </div>
        </div>
        <p id="ai-status" class="seo-ai__status" hidden></p>
    </div>

    <div class="seo-cols">

        <!-- Поля -->
        <div class="seo-stack">
            <form method="post" action="{{ admin_url('seo/save') }}" class="seo-card">
                <input type="hidden" name="key" value="{{ key }}">

                <!-- Заголовок -->
                <div class="seo-field">
                    <div class="seo-field__top">
                        <span class="seo-field__label">
                            SEO-заголовок
                            <button type="button" data-ai="title" title="Сгенерировать заголовок"
                                    class="seo-btn seo-btn--icon ai-run" {{ ai_ready ? '' : 'disabled' }}>
                                {{ icons.icon('sparkles') }}
                            </button>
                        </span>
                        <span class="seo-field__count"><span id="title-count">0</span> символов · оптимально 30–65</span>
                    </div>
                    <input type="text" name="title" id="f-title" value="{{ row.title ?? '' }}"
                           placeholder="{{ result.meta.title }}">
                    <p class="seo-field__hint">Пусто — на сайте работает заголовок из контента: «{{ result.meta.title }}»</p>
                    <div id="sug-title" class="seo-sug" hidden>
                        <p class="seo-sug__label">Предложение нейросети</p>
                        <p class="seo-sug__text" id="sug-title-text"></p>
                        <div class="seo-sug__actions">
                            <button type="button" data-apply="title" class="seo-btn seo-btn--ai seo-btn--sm">Применить</button>
                            <button type="button" data-cancel="title" class="seo-btn seo-btn--ghost seo-btn--sm">Отменить</button>
                        </div>
                    </div>
                </div>

                <!-- Описание -->
                <div class="seo-field">
                    <div class="seo-field__top">
                        <span class="seo-field__label">
                            Описание (description)
                            <button type="button" data-ai="description" title="Сгенерировать описание"
                                    class="seo-btn seo-btn--icon ai-run" {{ ai_ready ? '' : 'disabled' }}>
                                {{ icons.icon('sparkles') }}
                            </button>
                        </span>
                        <span class="seo-field__count"><span id="desc-count">0</span> символов · оптимально 70–170</span>
                    </div>
                    <textarea name="description" id="f-description" rows="3"
                              placeholder="{{ result.meta.description }}">{{ row.description ?? '' }}</textarea>
                    {% if not has_content %}
                    <p class="seo-field__hint seo-field__hint--warn">У страницы нет текста — модель будет опираться на заголовок и адрес.</p>
                    {% endif %}
                    <div id="sug-description" class="seo-sug" hidden>
                        <p class="seo-sug__label">Предложение нейросети</p>
                        <p class="seo-sug__text" id="sug-description-text"></p>
                        <div class="seo-sug__actions">
                            <button type="button" data-apply="description" class="seo-btn seo-btn--ai seo-btn--sm">Применить</button>
                            <button type="button" data-cancel="description" class="seo-btn seo-btn--ghost seo-btn--sm">Отменить</button>
                        </div>
                    </div>
                </div>

                <div class="seo-field-grid">
                    <!-- Ключевая фраза -->
                    <div class="seo-field">
                        <div class="seo-field__top">
                            <span class="seo-field__label">
                                Ключевая фраза
                                <button type="button" data-ai="keyword" title="Предложить фразы"
                                        class="seo-btn seo-btn--icon ai-run" {{ ai_ready ? '' : 'disabled' }}>
                                    {{ icons.icon('sparkles') }}
                                </button>
                            </span>
                        </div>
                        <input type="text" name="focus_keyword" id="f-keyword" value="{{ row.focus_keyword ?? '' }}"
                               placeholder="например: ремонт квартир под ключ">
                        <p class="seo-field__hint">По ней считаются позиция в заголовке, тексте, адресе и плотность.</p>
                        <div id="sug-keyword" class="seo-sug" hidden>
                            <p class="seo-sug__label">Варианты от нейросети — нажмите, чтобы выбрать</p>
                            <div id="sug-keyword-list" class="seo-sug__chips"></div>
                        </div>
                    </div>
                    <div class="seo-field">
                        <div class="seo-field__top">
                            <span class="seo-field__label">Robots</span>
                        </div>
                        {% set robots = row.robots ?? '' %}
                        <select name="robots">
                            <option value="" {{ robots == '' ? 'selected' : '' }}>по умолчанию (index,follow)</option>
                            <option value="index,follow" {{ robots == 'index,follow' ? 'selected' : '' }}>index,follow — индексировать</option>
                            <option value="noindex,follow" {{ robots == 'noindex,follow' ? 'selected' : '' }}>noindex,follow — не индексировать, ссылки учитывать</option>
                            <option value="noindex,nofollow" {{ robots == 'noindex,nofollow' ? 'selected' : '' }}>noindex,nofollow — закрыть полностью</option>
                        </select>
                    </div>
                </div>

                <div class="seo-field">
                    <div class="seo-field__top">
                        <span class="seo-field__label">Канонический адрес</span>
                    </div>
                    <input type="text" name="canonical" value="{{ row.canonical ?? '' }}" placeholder="{{ result.meta.canonical }}">
                    <p class="seo-field__hint">Пусто — берётся адрес страницы. Нужен, когда одну страницу открывают по нескольким адресам.</p>
                </div>

                <details class="seo-field" style="border-top:1px solid #e5e7eb;padding-top:16px;">
                    <summary class="seo-field__label" style="cursor:pointer;">Соцсети и Open Graph</summary>
                    <div style="margin-top:12px;">
                        <div class="seo-field">
                            <span class="seo-field__label">og:title</span>
                            <input type="text" name="og_title" value="{{ row.og_title ?? '' }}" placeholder="как в SEO-заголовке">
                        </div>
                        <div class="seo-field">
                            <span class="seo-field__label">og:description</span>
                            <textarea name="og_description" rows="2" placeholder="как в описании">{{ row.og_description ?? '' }}</textarea>
                        </div>
                        <div class="seo-field">
                            <span class="seo-field__label">og:image</span>
                            <input type="text" name="og_image" value="{{ row.og_image ?? '' }}" placeholder="{{ result.meta.image }}">
                            <p class="seo-field__hint">Путь от корня или полный URL. Пусто — картинка страницы, затем общая из настроек плагина.</p>
                        </div>
                    </div>
                </details>

                <div class="seo-actions">
                    <button type="submit" class="seo-btn seo-btn--primary">{{ icons.icon('check') }} Сохранить</button>
                    <button type="submit" name="reset" value="1"
                            onclick="return confirm('Снять SEO-поля и вернуть значения из контента?')"
                            class="seo-btn">Сбросить к контенту</button>
                    <a href="{{ doc.url }}" target="_blank" rel="noopener" class="seo-btn seo-btn--link">Открыть страницу</a>
                    <span class="seo-actions__note">Оценка пересчитывается при сохранении</span>
                </div>
            </form>

            <!-- Превью выдачи -->
            <div class="seo-card">
                <p class="seo-card__label">Как это выглядит в поиске</p>
                <div class="seo-snippet">
                    <div class="seo-snippet__url">{% if doc.updated_at %}{{ doc.updated_at|date('d.m.Y') }} — {% endif %}{{ doc.url }}</div>
                    <div id="preview-title" class="seo-snippet__title">{{ result.meta.display_title ?: doc.title }}</div>
                    <div id="preview-desc" class="seo-snippet__desc">{{ result.meta.description ?: 'Описание не задано — поисковик соберёт его сам.' }}</div>
                </div>
            </div>

            <div class="seo-card">
                <p class="seo-card__label">Текст страницы</p>
                <p class="seo-small">{{ result.stats.words }} слов</p>
                {% if result.stats.words == 0 %}
                <p class="seo-field__hint seo-field__hint--warn">Текст не найден: проверки объёма, H1 и плотности не считаются.</p>
                {% endif %}
            </div>
        </div>

        <!-- Оценка и чек-лист -->
        <div class="seo-stack">
            <div class="seo-card seo-card--center">
                <p class="seo-card__label">Оценка страницы</p>
                {% set score = result.score %}
                {% set level = result.level %}
                {% set ring = level == 'ok' ? '#16a34a' : (level == 'warn' ? '#d97706' : '#dc2626') %}
                <div class="seo-score">
                    <svg width="116" height="116" viewBox="0 0 116 116" aria-hidden="true">
                        <circle cx="58" cy="58" r="50" fill="none" stroke="#e5e7eb" stroke-width="10"></circle>
                        <circle cx="58" cy="58" r="50" fill="none" stroke="{{ ring }}" stroke-width="10"
                                stroke-linecap="round" stroke-dasharray="{{ (score * 314 / 100)|round(1) }} 314"
                                transform="rotate(-90 58 58)"></circle>
                    </svg>
                    <span class="seo-score__value seo-score__value--{{ level }}">{{ score }}</span>
                </div>
                <p class="seo-score__summary">{{ result.problems }} пункт(ов) требуют внимания</p>
                <p class="seo-score__summary">
                    {{ result.stats.words }} слов · H1: {{ result.stats.h1 }} ·
                    {% if result.stats.keyword_density is not null %}плотность {{ result.stats.keyword_density }}%{% else %}фраза не задана{% endif %}
                </p>
            </div>

            <div class="seo-card seo-card--flush">
                <div class="seo-card__head">Чек-лист</div>
                <div>
                    {% for check in result.checks %}
                    {% if check.status != 'na' %}
                    <div class="seo-check">
                        <span class="seo-check__icon seo-check__icon--{{ check.status }}">
                            {% if check.status == 'ok' %}{{ icons.icon('check-circle') }}
                            {% elseif check.status == 'warn' %}{{ icons.icon('alert-triangle') }}
                            {% else %}{{ icons.icon('x-circle') }}{% endif %}
                        </span>
                        <div>
                            <p class="seo-check__label">{{ check.label }}</p>
                            <p class="seo-check__message">{{ check.message }}</p>
                            {% if check.status != 'ok' %}
                            <p class="seo-check__hint">{{ check.hint }}</p>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div class="seo-card">
                <p class="seo-field__label">Канонический адрес</p>
                <p class="seo-small seo-break seo-muted" style="margin-top:4px;">{{ result.meta.canonical }}</p>
                <p class="seo-field__label" style="margin-top:14px;">Картинка для соцсетей</p>
                <p class="seo-small seo-break seo-muted" style="margin-top:4px;">{{ result.meta.image ?: 'не задана' }}</p>
            </div>
        </div>
    </div>
</div>
</div>

<script>
(function () {
    var title = document.getElementById('f-title');
    var desc = document.getElementById('f-description');
    var keyword = document.getElementById('f-keyword');
    var titleCount = document.getElementById('title-count');
    var descCount = document.getElementById('desc-count');
    var previewTitle = document.getElementById('preview-title');
    var previewDesc = document.getElementById('preview-desc');
    var contentTitle = {{ (result.meta.title ?: doc.title)|json_encode|raw }};
    var contentDesc = {{ (result.meta.description ?: '')|json_encode|raw }};
    var aiKey = {{ key|json_encode|raw }};

    // Счётчик показывает то, что реально уйдёт на сайт. Пустое поле — значит
    // работает значение из контента: показываем его длину серым и подписываем,
    // иначе «0 символов» красным рядом с чек-листом «описание задано»
    // выглядят как противоречие.
    function refresh() {
        var t = title.value.trim();
        var d = desc.value.trim();

        setCount(titleCount, t, contentTitle, 30, 65);
        setCount(descCount, d, contentDesc, 70, 170);

        previewTitle.textContent = t || contentTitle;
        previewDesc.textContent = d || contentDesc || 'Описание не задано — поисковик соберёт его сам.';
    }

    function setCount(el, own, fromContent, min, max) {
        var value = own !== '' ? own : fromContent;
        var fromContentNote = own === '' && value !== '';

        el.textContent = value.length + (fromContentNote ? ' (из контента)' : '');
        if (fromContentNote) {
            el.parentNode.className = 'seo-field__count seo-faint';
            return;
        }
        el.parentNode.className = 'seo-field__count '
            + (value.length < min || value.length > max ? 'is-bad' : 'is-good');
    }

    [title, desc].forEach(function (el) { el.addEventListener('input', refresh); });
    refresh();

    // ===== Предложения нейросети =====

    var status = document.getElementById('ai-status');
    var runButtons = document.querySelectorAll('.ai-run');
    var pending = {title: '', description: ''};

    function setBusy(busy, label) {
        runButtons.forEach(function (b) { b.disabled = busy; });
        if (busy) {
            status.hidden = false;
            status.classList.remove('is-error');
            status.textContent = label || 'Думаю…';
        } else {
            status.hidden = true;
            status.textContent = '';
        }
    }

    function showSuggestion(field, text) {
        var box = document.getElementById('sug-' + field);
        var out = document.getElementById('sug-' + field + '-text');
        if (!box || !out) return;
        pending[field] = text;
        out.textContent = text;
        box.hidden = false;
    }

    function hideSuggestion(field) {
        var box = document.getElementById('sug-' + field);
        if (box) box.hidden = true;
    }

    function showKeywords(list) {
        var box = document.getElementById('sug-keyword');
        var holder = document.getElementById('sug-keyword-list');
        if (!box || !holder) return;
        holder.innerHTML = '';
        list.forEach(function (phrase) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'seo-chip';
            b.textContent = phrase;
            b.addEventListener('click', function () {
                keyword.value = phrase;
                box.hidden = true;
            });
            holder.appendChild(b);
        });
        box.hidden = false;
    }

    document.querySelectorAll('[data-ai]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var field = btn.getAttribute('data-ai');
            setBusy(true, field === 'all' ? 'Готовлю заголовок, описание и фразы…' : 'Думаю…');

            var body = new FormData();
            body.append('key', aiKey);
            body.append('focus_keyword', keyword.value);
            body.append('field', field);

            fetch('{{ admin_url('seo/generate') }}', {
                method: 'POST',
                credentials: 'same-origin',
                body: body
            }).then(function (r) { return r.json(); }).then(function (data) {
                setBusy(false);
                if (!data.ok) {
                    status.hidden = false;
                    status.classList.add('is-error');
                    status.textContent = 'Не получилось: ' + (data.error || 'неизвестная ошибка');
                    return;
                }
                var d = data.data || {};
                if (d.title) showSuggestion('title', d.title);
                if (d.description) showSuggestion('description', d.description);
                if (d.keywords && d.keywords.length) showKeywords(d.keywords);
                else if (d.focus_keyword) showKeywords([d.focus_keyword]);
            }).catch(function (e) {
                setBusy(false);
                status.hidden = false;
                status.classList.add('is-error');
                status.textContent = 'Ошибка сети: ' + e.message;
            });
        });
    });

    document.querySelectorAll('[data-apply]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var field = btn.getAttribute('data-apply');
            if (field === 'title' && pending.title) {
                title.value = pending.title;
                hideSuggestion('title');
                refresh();
            }
            if (field === 'description' && pending.description) {
                desc.value = pending.description;
                hideSuggestion('description');
                refresh();
            }
        });
    });

    document.querySelectorAll('[data-cancel]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            hideSuggestion(btn.getAttribute('data-cancel'));
        });
    });
})();
</script>
{% endblock %}
