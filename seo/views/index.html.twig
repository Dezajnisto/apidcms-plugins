{% extends "base.html.twig" %}

{% block title %}SEO{% endblock %}
{% block page_title %}SEO — здоровье сайта{% endblock %}

{% block content %}
{% include '@seo/_styles.twig' %}
{% import '@seo/_icons.twig' as icons %}
<div class="seo-admin">
<div class="seo-wrap">

    {% if flash %}
    <div class="seo-flash {{ flash.type == 'error' ? 'seo-flash--error' : 'seo-flash--ok' }}">{{ flash.message }}</div>
    {% endif %}

    {% if not ai_ready %}
    <div class="seo-notice">
        <strong>Генерация недоступна:</strong> не задан ключ DeepSeek. Его берут из
        <a href="{{ admin_url('settings') }}" class="seo-link">настроек AI</a>.
        Остальные проверки работают без ключа.
    </div>
    {% endif %}

    {% set sitemap_on = settings_obj.bool('sitemap_enabled', true) %}

    <div class="seo-stats">
        <div class="seo-card">
            <p class="seo-stat__label">Средняя оценка</p>
            <p class="seo-stat__value {{ avg is null ? 'seo-stat__value--none' : (avg >= 80 ? 'seo-stat__value--good' : (avg >= 60 ? 'seo-stat__value--warn' : 'seo-stat__value--bad')) }}">
                {{ avg is null ? '—' : avg }}
            </p>
            <p class="seo-stat__hint">по проверенным страницам</p>
        </div>
        <div class="seo-card">
            <p class="seo-stat__label">Страниц в обходе</p>
            <p class="seo-stat__value">{{ counts.all }}</p>
            <p class="seo-stat__hint">проверено: {{ counts.all - counts.unchecked }}</p>
        </div>
        <div class="seo-card">
            <p class="seo-stat__label">Требуют работы</p>
            <p class="seo-stat__value seo-stat__value--bad">{{ counts.problems }}</p>
            <p class="seo-stat__hint">оценка ниже 60</p>
        </div>
        <div class="seo-card">
            <p class="seo-stat__label">Редиректы / 404</p>
            <p class="seo-stat__value">{{ redirects_count }} <span class="seo-faint">/</span> {{ notfound_count }}</p>
            <p class="seo-stat__hint">
                <a href="{{ admin_url('seo/redirects') }}" class="seo-link">редиректы</a>
                <span class="seo-faint">·</span>
                <a href="{{ admin_url('seo/notfound') }}" class="seo-link">ошибки</a>
            </p>
        </div>
    </div>

    <div class="seo-toolbar">
        <div class="seo-tabs">
            {% for key, label in {
                'all': 'Все (' ~ counts.all ~ ')',
                'problems': 'Требуют работы (' ~ counts.problems ~ ')',
                'unchecked': 'Не проверены (' ~ counts.unchecked ~ ')',
                'good': 'Хорошо (' ~ counts.good ~ ')'
            } %}
            <a href="{{ admin_url('seo') }}?filter={{ key }}{% if search %}&q={{ search|url_encode }}{% endif %}"
               class="seo-tab {{ filter == key ? 'is-active' : '' }}">{{ label }}</a>
            {% endfor %}
        </div>

        <div class="seo-toolbar__group">
            <form method="get" action="{{ admin_url('seo') }}" class="seo-toolbar__group">
                <input type="hidden" name="filter" value="{{ filter }}">
                <input type="text" name="q" value="{{ search }}" placeholder="адрес, заголовок, фраза" style="width:220px;">
                <button type="submit" class="seo-btn seo-btn--sm">Найти</button>
            </form>

            <button type="button" id="scan-btn" class="seo-btn seo-btn--primary seo-btn--sm">
                {{ icons.icon('stethoscope') }} Проверить сайт
            </button>

            <form method="post" action="{{ admin_url('seo/sitemap/rebuild') }}">
                <button type="submit" class="seo-btn seo-btn--sm">{{ icons.icon('refresh') }} Пересобрать sitemap</button>
            </form>

            <a href="/sitemap.xml" target="_blank" rel="noopener" class="seo-btn seo-btn--sm"
               {% if not sitemap_on %}style="opacity:.5;pointer-events:none;"{% endif %}>
                {{ icons.icon('external-link') }} /sitemap.xml
            </a>
        </div>
    </div>

    <div id="scan-progress" class="seo-progress" hidden>
        <div class="seo-progress__top">
            <span id="scan-text">Проверяю страницы…</span>
            <span id="scan-counter" class="seo-progress__counter"></span>
        </div>
        <div class="seo-progress__track"><div id="scan-bar" class="seo-progress__bar"></div></div>
    </div>

    <div class="seo-card seo-card--flush">
        {% if rows is empty %}
        <div class="seo-empty">
            {{ icons.icon('chart') }}
            <p>Нет страниц под этот фильтр</p>
            <p>Проверьте сайт кнопкой «Проверить сайт» — оценки появятся здесь.</p>
        </div>
        {% else %}
        <table class="seo-table">
            <thead>
                <tr>
                    <th style="width:80px;">Оценка</th>
                    <th>Страница</th>
                    <th style="width:180px;">Ключевая фраза</th>
                    <th style="width:240px;">Описание</th>
                    <th style="width:44px;"></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                <tr>
                    <td>
                        <span class="seo-badge seo-badge--{{ row.level }}">{{ row.score is null ? '—' : row.score }}</span>
                    </td>
                    <td>
                        <a href="{{ admin_url('seo/edit') }}?key={{ row.key|url_encode }}" class="seo-link">
                            {{ row.title is not empty ? row.title : '(без заголовка)' }}
                        </a>
                        <div class="seo-small seo-faint" style="margin-top:2px;">
                            {{ row.type == 'record' ? row.table ~ ' · ' : '' }}/{{ row.url|trim('/') }}
                            {% if row.title_own %}<span class="seo-kw" style="font-size:11px;">свой заголовок</span>{% endif %}
                        </div>
                    </td>
                    <td class="seo-small">
                        {% if row.focus_keyword %}
                            <span class="seo-kw">{{ row.focus_keyword }}</span>
                        {% else %}
                            <span class="seo-faint">не выбрана</span>
                        {% endif %}
                    </td>
                    <td class="seo-small">
                        {% if row.description %}
                            <span class="{{ row.description_own ? '' : 'seo-faint' }}"
                                  {% if not row.description_own %}title="Взято из контента страницы"{% endif %}>
                                {{ row.description|slice(0, 80) }}{{ row.description|length > 80 ? '…' }}
                            </span>
                            {% if not row.description_own %}
                            <span class="seo-faint" style="white-space:nowrap;"> · из контента</span>
                            {% endif %}
                        {% else %}
                            <span style="color:#dc2626;">пусто</span>
                        {% endif %}
                    </td>
                    <td style="text-align:right;">
                        <a href="{{ admin_url('seo/edit') }}?key={{ row.key|url_encode }}" class="seo-btn seo-btn--icon" title="Открыть">
                            {{ icons.icon('pen') }}
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if total_filtered > rows|length %}
        <div class="seo-card__head" style="border-top:1px solid #e5e7eb;border-bottom:none;">
            Показано {{ rows|length }} из {{ total_filtered }}. Уточните поиск или используйте фильтры.
        </div>
        {% endif %}
        {% endif %}
    </div>

    <div class="seo-card" style="margin-top:16px;">
        <p class="seo-small seo-muted">
            <strong>Оценка</strong> считается по чек-листу из 20+ пунктов: заголовок, описание, объём текста,
            H1, ключевая фраза и её плотность, alt у картинок, читаемость адреса, картинка для соцсетей,
            noindex. Проверка офлайновая — сайт не тормозит, интернет и токены не нужны.
        </p>
        <p class="seo-small seo-muted" style="margin-top:8px;">
            <strong>Заголовок, описание и ключевую фразу</strong> можно сгенерировать нейросетью: откройте
            страницу в списке — панель «Заполнить нейросетью» вверху редактора. Результат сначала
            показывается предложением, ничего не перезаписывается молча.
        </p>
    </div>
</div>
</div>

<script>
(function () {
    var btn = document.getElementById('scan-btn');
    if (!btn) return;
    var box = document.getElementById('scan-progress');
    var text = document.getElementById('scan-text');
    var counter = document.getElementById('scan-counter');
    var bar = document.getElementById('scan-bar');
    var running = false;

    function step(offset) {
        var url = '{{ admin_url('seo/scan') }}?offset=' + offset + '&limit=25';
        fetch(url, {credentials: 'same-origin'})
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.ok) {
                    text.textContent = 'Ошибка: ' + (data.error || 'неизвестно');
                    running = false;
                    btn.disabled = false;
                    return;
                }
                var percent = data.total > 0 ? Math.round(data.done * 100 / data.total) : 100;
                bar.style.width = percent + '%';
                counter.textContent = data.done + ' / ' + data.total;
                if (data.finished) {
                    text.textContent = 'Готово — обновляю страницу';
                    btn.disabled = false;
                    running = false;
                    setTimeout(function () { location.reload(); }, 900);
                    return;
                }
                step(data.done);
            })
            .catch(function (e) {
                text.textContent = 'Прервано: ' + e.message;
                btn.disabled = false;
                running = false;
            });
    }

    btn.addEventListener('click', function () {
        if (running) return;
        running = true;
        btn.disabled = true;
        box.hidden = false;
        text.textContent = 'Проверяю страницы…';
        step(0);
    });
})();
</script>
{% endblock %}
