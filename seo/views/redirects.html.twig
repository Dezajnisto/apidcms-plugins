{% extends "base.html.twig" %}

{% block title %}Редиректы{% endblock %}
{% block page_title %}SEO — редиректы{% endblock %}

{% block content %}
{% include '@seo/_styles.twig' %}
{% import '@seo/_icons.twig' as icons %}
<div class="seo-admin">
<div class="seo-wrap">

    {% if flash %}
    <div class="seo-flash {{ flash.type == 'error' ? 'seo-flash--error' : 'seo-flash--ok' }}">{{ flash.message }}</div>
    {% endif %}

    <div class="seo-toolbar">
        <div class="seo-toolbar__group">
            <a href="{{ admin_url('seo') }}" class="seo-btn seo-btn--link">{{ icons.icon('arrow-left') }} к обзору</a>
            <a href="{{ admin_url('seo/notfound') }}" class="seo-link seo-small">журнал 404</a>
        </div>
    </div>

    <div class="seo-cols seo-cols--even">

        <div class="seo-card seo-card--flush">
            <div class="seo-card__head">Постоянные редиректы (301)</div>
            {% if rows is empty %}
            <div class="seo-empty">
                {{ icons.icon('arrows-right-left') }}
                <p>Редиректов нет</p>
                <p>Добавьте первый — переезд страницы перестанет съедать трафик.</p>
            </div>
            {% else %}
            <table class="seo-table">
                <thead>
                    <tr>
                        <th>Откуда</th>
                        <th>Куда</th>
                        <th class="seo-table__num" style="width:110px;">Срабатываний</th>
                        <th style="width:44px;"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                    <tr>
                        <td class="seo-table__mono">{{ row.from_path }}</td>
                        <td class="seo-table__mono seo-muted">{{ row.to_path }}</td>
                        <td class="seo-table__num {{ row.hits > 0 ? '' : 'seo-faint' }}">
                            <span class="{{ row.hits > 0 ? 'seo-badge seo-badge--none' : '' }}">{{ row.hits }}</span>
                        </td>
                        <td style="text-align:right;">
                            <form method="post" action="{{ admin_url('seo/redirects/delete/' ~ row.id) }}"
                                  onsubmit="return confirm('Удалить редирект?')">
                                <button type="submit" class="seo-btn seo-btn--icon seo-btn--danger" title="Удалить">
                                    {{ icons.icon('trash') }}
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>

        <div class="seo-card" style="align-self:start;">
            <p class="seo-field__label" style="margin-bottom:12px;">Новый редирект</p>
            <form method="post" action="{{ admin_url('seo/redirects/save') }}">
                <div class="seo-field">
                    <div class="seo-field__top"><span class="seo-small seo-muted">Старый адрес</span></div>
                    <input type="text" name="from_path" value="{{ prefill_from }}" placeholder="/staryj-adres" class="seo-mono">
                </div>
                <div class="seo-field">
                    <div class="seo-field__top"><span class="seo-small seo-muted">Новый адрес</span></div>
                    <input type="text" name="to_path" placeholder="/novyj-adres" class="seo-mono">
                </div>
                <button type="submit" class="seo-btn seo-btn--primary" style="width:100%;">Добавить</button>
            </form>
            <p class="seo-small seo-muted" style="margin-top:12px;">
                Редирект работает для точного адреса — без учёта параметров в ссылке.
                Если старый адрес ещё существует в контенте, откроется страница, а редирект не сработает.
            </p>
        </div>
    </div>
</div>
</div>
{% endblock %}
