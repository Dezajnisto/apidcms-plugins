{% extends 'base.html.twig' %}

{% block title %}Ожидание оплаты — {{ site_title }}{% endblock %}

{% block content %}
<div style="text-align:center;padding:40px 20px;max-width:600px;margin:0 auto;">
    <div style="font-size:4rem;margin-bottom:20px;">⏳</div>
    <h1 style="color:var(--accent);margin-bottom:16px;">Ожидание оплаты</h1>
    <p style="color:var(--muted);font-size:1.1rem;margin-bottom:24px;">
        {{ subscription.plan_name }} — {{ subscription.amount }} &#8381; / {{ format_duration(subscription.duration_days) }}
    </p>
    <p style="color:var(--muted);margin-bottom:32px;">
        Платёж ещё обрабатывается. Обычно это занимает несколько минут.<br>
        Мы уведомим вас, когда подписка будет активирована.
    </p>
    <a href="/profile" class="btn btn--primary" style="display:inline-block;padding:12px 32px;text-decoration:none;border-radius:8px;font-weight:600;">
        Перейти в профиль
    </a>
</div>
{% endblock %}
