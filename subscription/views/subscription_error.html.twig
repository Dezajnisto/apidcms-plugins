{% extends 'base.html.twig' %}

{% block title %}Ошибка оплаты — {{ site_title }}{% endblock %}

{% block content %}
<div style="text-align:center;padding:40px 20px;max-width:600px;margin:0 auto;">
    <div style="font-size:4rem;margin-bottom:20px;">❌</div>
    <h1 style="color:#EF4444;margin-bottom:16px;">Ошибка оплаты</h1>
    <p style="color:var(--muted);font-size:1.1rem;margin-bottom:24px;">
        {{ error|default('Что-то пошло не так при обработке платежа.') }}
    </p>
    <p style="color:var(--muted);margin-bottom:32px;">
        Попробуйте ещё раз или свяжитесь с поддержкой.
    </p>
    <a href="/profile" class="btn btn--primary" style="display:inline-block;padding:12px 32px;text-decoration:none;border-radius:8px;font-weight:600;">
        Вернуться в профиль
    </a>
</div>
{% endblock %}
