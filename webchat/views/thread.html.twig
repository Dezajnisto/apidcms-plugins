{% extends "base.html.twig" %}

{% block title %}Обращение #{{ thread.id }}{% endblock %}
{% block page_title %}Обращение #{{ thread.id }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">

    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div>
            <a href="{{ admin_url('chats') }}" class="text-sm text-blue-600 hover:underline">← ко всем чатам</a>
            <div class="mt-1 text-sm text-gray-600">
                {{ thread.visitor_name ?: 'Посетитель' }}
                {% if thread.visitor_contact %} · {{ thread.visitor_contact }}{% endif %}
                · начат {{ thread.created_at|slice(0, 16) }}
            </div>
            {% if thread.page_url %}
            <div class="text-xs text-gray-500 mt-0.5 break-all">{{ thread.page_url }}</div>
            {% endif %}
        </div>

        <div class="flex items-center gap-2">
            {% if thread.status == 'closed' %}
            <span class="px-2 py-0.5 rounded-full bg-gray-200 text-gray-700 text-xs">закрыт</span>
            {% else %}
            <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-800 text-xs">открыт</span>
            {% endif %}

            <form method="post" action="{{ admin_url('chats/' ~ thread.id ~ '/status') }}">
                <input type="hidden" name="status" value="{{ thread.status == 'closed' ? 'open' : 'closed' }}">
                <button type="submit" class="px-3 py-1.5 border border-gray-300 rounded-md text-sm hover:bg-gray-50">
                    {{ thread.status == 'closed' ? 'Открыть заново' : 'Закрыть' }}
                </button>
            </form>

            <form method="post" action="{{ admin_url('chats/' ~ thread.id ~ '/delete') }}"
                  onsubmit="return confirm('Удалить обращение и всю переписку?')">
                <button type="submit" class="px-3 py-1.5 border border-red-300 text-red-700 rounded-md text-sm hover:bg-red-50">
                    Удалить
                </button>
            </form>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border">
        <div class="p-4 space-y-3 max-h-[60vh] overflow-y-auto">
            {% for m in messages %}
            <div class="flex {{ m.direction == 'out' ? 'justify-end' : 'justify-start' }}">
                <div class="max-w-[75%] rounded-lg px-3 py-2 text-sm {{ m.direction == 'out' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-900' }}">
                    <div class="whitespace-pre-wrap break-words">{{ m.body }}</div>
                    <div class="text-[11px] mt-1 {{ m.direction == 'out' ? 'text-blue-100' : 'text-gray-500' }}">
                        {{ m.author }} · {{ m.created_at|slice(0, 16) }}
                    </div>
                </div>
            </div>
            {% else %}
            <p class="text-center text-gray-500 text-sm py-6">Сообщений нет</p>
            {% endfor %}
        </div>

        <form method="post" action="{{ admin_url('chats/' ~ thread.id ~ '/reply') }}" class="border-t p-4">
            <textarea name="text" rows="3" placeholder="Ответить посетителю…"
                      class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            <div class="mt-2 flex items-center justify-between">
                <p class="text-xs text-gray-500">
                    {% if channel_ready %}
                    Ответ появится у посетителя в виджете в течение нескольких секунд.
                    {% else %}
                    Канал не настроен — ответ уйдёт только в виджет, оператор его не увидит в мессенджере.
                    {% endif %}
                </p>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700">
                    Отправить
                </button>
            </div>
        </form>
    </div>

    <div class="mt-4 text-xs text-gray-500">
        IP (хеш): {{ thread.ip_hash }} · браузер: {{ thread.user_agent|slice(0, 120) }}
    </div>
</div>
{% endblock %}
