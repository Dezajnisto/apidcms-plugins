{% extends "base.html.twig" %}

{% block title %}Редиректы{% endblock %}
{% block page_title %}SEO — редиректы{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">

    {% if flash %}
    <div class="mb-4 rounded-lg border px-4 py-3 text-sm {{ flash.type == 'error' ? 'border-red-300 bg-red-50 text-red-800' : 'border-green-300 bg-green-50 text-green-800' }}">
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="flex items-center gap-3 mb-5 text-sm">
        <a href="{{ admin_url('seo') }}" class="text-gray-500 hover:text-blue-600">
            <i class="fas fa-arrow-left mr-1"></i> к обзору
        </a>
        <a href="{{ admin_url('seo/notfound') }}" class="text-blue-600 hover:underline">журнал 404</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-lg border overflow-hidden">
            <div class="px-4 py-3 border-b text-xs uppercase tracking-wide text-gray-500">
                Постоянные редиректы (301)
            </div>
            {% if rows is empty %}
            <div class="p-10 text-center text-gray-500 text-sm">
                <i class="fas fa-right-left text-3xl text-gray-300 mb-2 block"></i>
                Редиректов нет. Добавьте первый — переезд страницы перестанет съедать трафик.
            </div>
            {% else %}
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="px-4 py-2.5 text-left font-medium">Откуда</th>
                        <th class="px-4 py-2.5 text-left font-medium">Куда</th>
                        <th class="px-4 py-2.5 text-right font-medium w-24">Срабатываний</th>
                        <th class="px-4 py-2.5 w-10"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for row in rows %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-2.5 font-mono text-xs text-gray-800">{{ row.from_path }}</td>
                        <td class="px-4 py-2.5 font-mono text-xs text-gray-600">{{ row.to_path }}</td>
                        <td class="px-4 py-2.5 text-right text-xs {{ row.hits > 0 ? 'text-gray-800 font-medium' : 'text-gray-400' }}">{{ row.hits }}</td>
                        <td class="px-4 py-2.5 text-right">
                            <form method="post" action="{{ admin_url('seo/redirects/delete/' ~ row.id) }}"
                                  onsubmit="return confirm('Удалить редирект?')">
                                <button type="submit" class="text-gray-400 hover:text-red-600">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>

        <div class="bg-white rounded-lg border p-5 h-fit">
            <p class="text-sm font-medium text-gray-800 mb-3">Новый редирект</p>
            <form method="post" action="{{ admin_url('seo/redirects/save') }}" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Старый адрес</label>
                    <input type="text" name="from_path" value="{{ prefill_from }}" placeholder="/staryj-adres"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Новый адрес</label>
                    <input type="text" name="to_path" placeholder="/novyj-adres"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono">
                </div>
                <button type="submit" class="w-full px-3 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700">
                    Добавить
                </button>
            </form>
            <p class="mt-3 text-xs text-gray-500">
                Редирект работает только для точного адреса — без учёта параметров в ссылке.
                Если старый адрес уже существует в контенте, страница откроется, а редирект не сработает.
            </p>
        </div>
    </div>
</div>
{% endblock %}
