{% extends "base.html.twig" %}

{% block content %}
<div class="max-w-md mx-auto mt-12 px-4">
    <h1 class="text-2xl font-bold text-center mb-8">{{ title }}</h1>

    {% if success %}
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-md mb-6">
        {{ success }}
    </div>
    {% endif %}

    {% if error %}
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md mb-6">
        {{ error }}
    </div>
    {% endif %}

    <form method="post" action="/account/change-password" class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Текущий пароль</label>
            <input type="password" name="current_password" required
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Новый пароль</label>
            <input type="password" name="new_password" required minlength="6"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Повторите новый пароль</label>
            <input type="password" name="new_password2" required minlength="6"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition">
            Сменить пароль
        </button>
    </form>

    <p class="text-center text-sm text-gray-500 mt-4">
        <a href="/profile" class="text-blue-600 hover:underline">Вернуться в профиль</a>
    </p>
</div>
{% endblock %}
