{#
    Иконки плагина — инлайн SVG, без Font Awesome.

    Почему не `<i class="fas fa-...">`: админка ядра подключает Font Awesome
    с cdnjs, и шрифт (woff2/ttf) реально не загружается — запросы падают с
    net::ERR_FAILED при том, что сам CSS отдаётся с кодом 200. В результате
    все иконки в интерфейсе превращаются в пустые квадраты. Плагин не должен
    зависеть от внешней сети: SVG в разметке рисуется всегда.

    Размер — 1em, цвет — currentColor, поэтому иконка наследует размер и цвет
    текста рядом, как это делал Font Awesome.
#}

{% macro icon(name, size) %}
{%- set s = size|default(16) -%}
<svg class="seo-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em;">
{%- if name == 'arrow-left' -%}
    <line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>
{%- elseif name == 'external-link' -%}
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
    <polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line>
{%- elseif name == 'sparkles' -%}
    <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"></path>
    <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"></path>
    <path d="M5 14l.6 1.6L7.2 16l-1.6.6L5 18l-.6-1.4L2.8 16l1.6-.4L5 14z"></path>
{%- elseif name == 'check' -%}
    <polyline points="20 6 9 17 4 12"></polyline>
{%- elseif name == 'check-circle' -%}
    <circle cx="12" cy="12" r="9"></circle><polyline points="8.5 12.5 11 15 16 9.5"></polyline>
{%- elseif name == 'alert-triangle' -%}
    <path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
    <line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line>
{%- elseif name == 'x-circle' -%}
    <circle cx="12" cy="12" r="9"></circle><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line>
{%- elseif name == 'trash' -%}
    <polyline points="3 6 5 6 21 6"></polyline>
    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
    <path d="M10 11v6M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
{%- elseif name == 'pen' -%}
    <path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
{%- elseif name == 'stethoscope' -%}
    <path d="M4 3v6a4 4 0 0 0 8 0V3"></path><path d="M2 3h4M10 3h4"></path>
    <path d="M8 13v3a5 5 0 0 0 10 0v-2"></path><circle cx="18" cy="11" r="2"></circle>
{%- elseif name == 'refresh' -%}
    <polyline points="21 4 21 10 15 10"></polyline><polyline points="3 20 3 14 9 14"></polyline>
    <path d="M4.6 9a8 8 0 0 1 13.2-3L21 9"></path><path d="M19.4 15a8 8 0 0 1-13.2 3L3 15"></path>
{%- elseif name == 'arrows-right-left' -%}
    <polyline points="17 3 21 7 17 11"></polyline><line x1="21" y1="7" x2="9" y2="7"></line>
    <polyline points="7 13 3 17 7 21"></polyline><line x1="3" y1="17" x2="15" y2="17"></line>
{%- elseif name == 'chart' -%}
    <line x1="3" y1="21" x2="21" y2="21"></line><rect x="5" y="12" width="4" height="6"></rect>
    <rect x="11" y="8" width="4" height="10"></rect><rect x="17" y="4" width="4" height="14"></rect>
{%- elseif name == 'inbox' -%}
    <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
    <path d="M5.4 5.1L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.4-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.8 1.1z"></path>
{%- endif -%}
</svg>
{% endmacro %}
