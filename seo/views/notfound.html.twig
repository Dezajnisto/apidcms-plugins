{% extends "base.html.twig" %}

{% block title %}Ошибки 404{% endblock %}
{% block page_title %}SEO — ошибки 404{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-6">

    {% if flash %}
    <div class="mb-4 rounded-lg border px-4 py-3 text-sm {{ flash.type == 'error' ? 'border-red-300 bg-red-50 text-red-800' : 'border-green-300 bg-green-50 text-green-800' }}">
        {{ flash.message }}
    </div>
    {% endif %}

    <div class="flex items-center gap-3 mb-5 text-sm">
        <a href="{{ admin_url('seo') }}" class="text-gray-500 hover:text-blue-600">
            <i class="fas fa-arrow-left mr-1"></i> к обзору
        </a>
        <a href="{{ admin_url('seo/redirects') }}" class="text-blue-600 hover:underline">редиректы</a>
    </div>

    <div class="bg-white rounded-lg border overflow-hidden">
        <div class="px-4 py-3 border-b text-xs uppercase tracking-wide text-gray-500 flex items-center justify-between">
            <span>Адреса, которых нет (топ по обращениям)</span>
            <span class="text-gray-400 normal-case">рекомендуемый адрес — предположение по похожести, проверяйте глазами</span>
        </div>
        {% if rows is empty %}
        <div class="p-10 text-center text-gray-500 text-sm">
            <i class="fas fa-check text-3xl text-green-300 mb-2 block"></i>
            Хорошая новость: 404 не приходили с момента установки плагина.
        </div>
        {% else %}
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="px-4 py-2.5 text-left font-medium">Адрес</th>
                    <th class="px-4 py-2.5 text-right font-medium w-28">Обращений</th>
                    <th class="px-4 py-2.5 text-left font-medium w-56">Последний раз</th>
                    <th class="px-4 py-2.5 text-left font-medium">Куда перенаправить</th>
                    <th class="px-4 py-2.5 w-10"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for row in rows %}
                <tr class="hover:bg-gray-50 align-top">
                    <td class="px-4 py-2.5 font-mono text-xs text-gray-800">{{ row.path }}</td>
                    <td class="px-4 py-2.5 text-right text-xs {{ row.hits > 1 ? 'font-medium text-gray-800' : 'text-gray-500' }}">{{ row.hits }}</td>
                    <td class="px-4 py-2.5 text-xs text-gray-500">{{ row.last_seen }}</td>
                    <td class="px-4 py-2.5">
                        {% if row.suggest %}
                        <form method="post" action="{{ admin_url('seo/redirects/save') }}" class="flex items-center gap-1">
                            <input type="hidden" name="from_path" value="{{ row.path }}">
                            <input type="text" name="to_path" value="{{ row.suggest }}"
                                   class="px-2 py-1 border border-gray-300 rounded text-xs font-mono w-40">
                            <button type="submit" class="px-2 py-1 bg-blue-600 text-white rounded text-xs hover:bg-blue-700">301</button>
                        </form>
                        {% else %}
                        <span class="text-xs text-gray-400">похожих адресов нет</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-2.5 text-right">
                        <form method="post" action="{{ admin_url('seo/notfound/delete/' ~ row.id) }}"
                              onsubmit="return confirm('Удалить запись из журнала?')">
                            <button type="submit" class="text-gray-400 hover:text-red-600">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

    <p class="mt-4 text-xs text-gray-500">
        Журнал ведётся на страницах ошибки. Технические адреса (файлы стилей, картинки, /admin) в него не попадают,
        чтобы отчёт не утонул в мусоре. Устаревшие записи удаляются кнопкой — журнал не чистится автоматически.
    </p>
</div>
{% endblock %}
